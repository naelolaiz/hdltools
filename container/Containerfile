# syntax=docker/dockerfile:1

ARG UBUNTU_IMAGE=docker.io/library/ubuntu:22.04
ARG GHDL_IMAGE=docker.io/ghdl/ghdl:6.0.0-llvm-ubuntu-22.04


# ---- Build Yosys + ghdl-yosys-plugin from source in a throwaway stage ----
FROM ${GHDL_IMAGE} AS yosys-builder
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates git make g++ python3 \
      bison flex gawk clang libffi-dev libfl-dev libreadline-dev \
      pkg-config tcl-dev zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --depth 1 --recurse-submodules --shallow-submodules \
      https://github.com/YosysHQ/yosys.git \
 && make -C yosys -j"$(nproc)" \
 && make -C yosys install

# Pinned: commit just before the plugin started calling Sname_Index / get_sname_index,
# which aren't in the ghdl 6.0.0 base image. Bump when the base ghdl version is bumped.
ARG GHDL_YOSYS_PLUGIN_REF=07a30ed39fb6a078f1bf7e9e88ce9ed712380ec2
RUN git clone https://github.com/ghdl/ghdl-yosys-plugin.git \
 && git -C ghdl-yosys-plugin checkout "$GHDL_YOSYS_PLUGIN_REF" \
 && make -C ghdl-yosys-plugin -j"$(nproc)" \
 && make -C ghdl-yosys-plugin install


# ---- Build Icarus Verilog from source ----
# Ubuntu 22.04 apt ships iverilog 11.0; we want FST waveform output via
# `vvp <design>.vvp -fst`, which needs the system.vpi extended-arg
# parser shipped in v12.0+ and is the default output recommendation for
# GTKWave / Surfer. Pinned to v13_0 (stable, March 2026). Built on plain
# ubuntu:22.04 to match the runtime base's libc/libstdc++ so the
# resulting binaries drop straight into the runtime image.
FROM ${UBUNTU_IMAGE} AS iverilog-builder
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates git build-essential autoconf gperf bison flex \
      libreadline-dev zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*

ARG IVERILOG_REF=v13_0
WORKDIR /src
RUN git clone --depth 1 --branch "$IVERILOG_REF" \
      https://github.com/steveicarus/iverilog.git \
 && cd iverilog \
 && sh autoconf.sh \
 && ./configure --prefix=/opt/iverilog \
 && make -j"$(nproc)" \
 && make install


# ---- Build Verilator from source ----
# The only mature open-source SystemVerilog simulator. v5.x has solid
# support for SV-2017's synthesizable subset plus much of the verification
# subset (interfaces, packages, packed structs, classes-lite). Pinned to
# the v5.048 release tag for reproducibility — bump to upgrade.
FROM ${UBUNTU_IMAGE} AS verilator-builder
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates git build-essential autoconf bison flex \
      perl python3 help2man libfl-dev libfl2 zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*

ARG VERILATOR_REF=v5.048
WORKDIR /src
RUN git clone --depth 1 --branch "$VERILATOR_REF" \
      https://github.com/verilator/verilator.git \
 && cd verilator \
 && autoconf \
 && ./configure --prefix=/opt/verilator \
 && make -j"$(nproc)" \
 && make install


# ---- Build slang from source ----
# Modern SystemVerilog 2017 parser/elaborator/linter. Best-in-class
# conformance and very fast — useful as a standalone lint pass and as
# the front-end yosys-slang plugs into for SV synthesis. Needs CMake
# >= 3.20 and gcc >= 11; ubuntu 22.04 ships 3.22.1 / 11.4 so the default
# toolchain is enough.
FROM ${UBUNTU_IMAGE} AS slang-builder
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates git build-essential cmake python3 \
 && rm -rf /var/lib/apt/lists/*

ARG SLANG_REF=v10.0
WORKDIR /src
RUN git clone --depth 1 --branch "$SLANG_REF" \
      https://github.com/MikePopoloski/slang.git \
 && cmake -S slang -B slang/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/opt/slang \
      -DSLANG_INCLUDE_TESTS=OFF \
 && cmake --build slang/build --parallel "$(nproc)" \
 && cmake --install slang/build --strip


# ---- Build netlistsvg into a copyable npm prefix ----
FROM ${UBUNTU_IMAGE} AS netlistsvg-builder
ENV DEBIAN_FRONTEND=noninteractive

# Install netlistsvg from the hierarchical fork — gives clickable
# submodule drilldown pages with external port markers. Pinned to the
# tagged snapshot so bumps are deliberate; NETLISTSVG_REF_SHA records
# the commit the tag currently resolves to and is referenced inside
# the RUN below to invalidate the Docker layer cache when the tag is
# re-pointed.
ARG NETLISTSVG_REF=hierarchy-drilldown-v1
ARG NETLISTSVG_REF_SHA=472791b44884458ccae5f8046229afbb61db0050

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates git nodejs npm \
 && rm -rf /var/lib/apt/lists/*

ENV npm_config_prefix=/opt/netlistsvg
RUN echo "netlistsvg tag-snapshot SHA: $NETLISTSVG_REF_SHA" \
 && npm install -g --no-fund --no-audit "git+https://github.com/naelolaiz/netlistsvg.git#$NETLISTSVG_REF" \
 && npm cache clean --force \
 && rm -rf /root/.npm /root/.cache


# ---- Build waveview into a copyable Python prefix ----
FROM ${UBUNTU_IMAGE} AS waveview-builder
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates gcc pkg-config python3 python3-dev python3-pip \
      python3-venv libcairo2-dev fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*

COPY waveview/ /src/waveview/
RUN python3 -m venv /opt/waveview \
 && /opt/waveview/bin/pip install --no-cache-dir /src/waveview/ \
 && rm -rf /root/.cache


# ---- Small reusable runtime foundations ----
FROM ${UBUNTU_IMAGE} AS ubuntu-min
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /work
CMD ["/bin/bash"]


FROM ubuntu-min AS ubuntu-work

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      make python3 perl tar gawk sed findutils \
 && rm -rf /var/lib/apt/lists/*


FROM ${GHDL_IMAGE} AS ghdl
ENV DEBIAN_FRONTEND=noninteractive

# libghdl has its std/ieee path baked in from GHDL's own CI build
# (/home/runner/work/ghdl/ghdl/...) so the yosys -m ghdl pipeline can't
# find the VHDL standard libraries unless we set GHDL_PREFIX to the real
# location inside the pinned base image. If the base image layout ever
# changes, the CI smoke test in docker-image.yml fails loudly before the
# image is published.
ENV GHDL_PREFIX=/opt/ghdl/lib/ghdl

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates make python3 perl tar gawk sed findutils \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /work
CMD ["/bin/bash"]


# ---- Standalone tool modules ----
FROM ghdl AS yosys

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libffi8 libfl2 libreadline8 libtcl8.6 zlib1g \
 && rm -rf /var/lib/apt/lists/*

COPY --from=yosys-builder /usr/local/bin/yosys* /usr/local/bin/
COPY --from=yosys-builder /usr/local/share/yosys/ /usr/local/share/yosys/


FROM ubuntu-min AS iverilog

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libreadline8 zlib1g \
 && rm -rf /var/lib/apt/lists/*

COPY --from=iverilog-builder /opt/iverilog/ /opt/iverilog/
ENV PATH=/opt/iverilog/bin:$PATH


FROM ubuntu-min AS verilator

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      g++ libfl2 make perl python3 zlib1g \
 && rm -rf /var/lib/apt/lists/*

COPY --from=verilator-builder /opt/verilator/ /opt/verilator/
ENV PATH=/opt/verilator/bin:$PATH


FROM ubuntu-min AS slang

COPY --from=slang-builder /opt/slang/ /opt/slang/
ENV PATH=/opt/slang/bin:$PATH


FROM ubuntu-min AS netlistsvg

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      nodejs \
 && rm -rf /var/lib/apt/lists/*

COPY --from=netlistsvg-builder /opt/netlistsvg/ /opt/netlistsvg/
ENV PATH=/opt/netlistsvg/bin:$PATH


FROM ubuntu-min AS waveview

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      fonts-dejavu-core libcairo2 python3 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=waveview-builder /opt/waveview/ /opt/waveview/
ENV PATH=/opt/waveview/bin:$PATH


FROM yosys AS vhd2svg

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      nodejs \
 && rm -rf /var/lib/apt/lists/*

COPY --from=netlistsvg-builder /opt/netlistsvg/ /opt/netlistsvg/
ENV PATH=/opt/netlistsvg/bin:$PATH
COPY vhd2svg.sh /tools/


# ---- Default all-in-one image ----
FROM vhd2svg AS hdltools

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      g++ fonts-dejavu-core libcairo2 libfl2 libreadline8 libtcl8.6 \
      libffi8 zlib1g \
 && rm -rf /var/lib/apt/lists/*

COPY --from=iverilog /opt/iverilog/ /opt/iverilog/
COPY --from=verilator /opt/verilator/ /opt/verilator/
COPY --from=slang /opt/slang/ /opt/slang/
COPY --from=waveview /opt/waveview/ /opt/waveview/
ENV PATH=/opt/iverilog/bin:/opt/verilator/bin:/opt/slang/bin:/opt/waveview/bin:/opt/netlistsvg/bin:$PATH

CMD ["/bin/bash"]
